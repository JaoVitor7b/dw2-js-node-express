<body class="pagina-enemies">
<%- include('partials/header.ejs') %>
    <%- include('partials/navbar.ejs') %>

    <img class="logo" src="./images/logo.png" alt="darksouls" />

        <section class="cards-container">

    <article class="card">
        <img src="../images/AsylumDemon.webp" alt="Asylum Demon">

        <div class="card-conteudo">
            <h2>Asylum Demon</h2>
            <p>
                Primeiro chefe, ensina mecânicas básicas e intimida pelo tamanho.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/TaurusDemon.jpg" alt="Taurus Demon">

        <div class="card-conteudo">
            <h2>Taurus Demon</h2>
            <p>
                Guardião da ponte em Undead Burg, força o jogador a usar o ambiente.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/BellGargoyles.jpeg" alt="Bell Gargoyles">

        <div class="card-conteudo">
            <h2>Bell Gargoyles</h2>
            <p>
                Dois inimigos simultâneos que protegem o sino da catedral.
            </p>
        </div>
    </article>
    <article class="card">
        <img src="../images/CapraDemon.webp" alt="Capra Demon">

        <div class="card-conteudo">
            <h2>Capra Demon</h2>
            <p>
                Luta em arena pequena com cães, famosa pela dificuldade inicial.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/gaping.webp" alt="Gaping Dragon">

        <div class="card-conteudo">
            <h2>Gaping Dragon</h2>
            <p>
                Dragão deformado que mostra o grotesco estilo do jogo.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/Quelaag.jpg" alt="Chaos Witch Quelaag">

        <div class="card-conteudo">
            <h2>Chaos Witch Quelaag</h2>
            <p>
                Bruxa metade aranha, guardiã do segundo sino.
            </p>
        </div>
    </article>
        <article class="card">
        <img src="../images/Iron.jpg" alt="Iron Golem">

        <div class="card-conteudo">
            <h2>Iron Golem</h2>
            <p>
                Guardião de Sen’s Fortress, derrota abre caminho para Anor Londo.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/Ornstein.avif" alt="Ornstein and Smough">

        <div class="card-conteudo">
            <h2>Ornstein and Smough</h2>
            <p>
                Dupla lendária, equilíbrio entre velocidade e força.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/Seath.jpg" alt="Seath the Scaleless">

        <div class="card-conteudo">
            <h2>Seath the Scaleless</h2>
            <p>
                Dragão traidor, essencial para a história dos Lord Souls.
            </p>
        </div>
    </article>
        <article class="card">
        <img src="../images/Nito.webp" alt="Gravelord Nito">

        <div class="card-conteudo">
            <h2>Gravelord Nito</h2>
            <p>
                Senhor da Morte, luta em caverna cheia de esqueletos.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/Four.jpg" alt="Four Kings">

        <div class="card-conteudo">
            <h2>Four Kings</h2>
            <p>
                Chefes múltiplos em arena escura, pressão constante.
            </p>
        </div>
    </article>

    <article class="card">
        <img src="../images/Chaos.webp" alt="Bed of Chaos">

        <div class="card-conteudo">
            <h2>Bed of Chaos</h2>
            <p>
                Considerado um dos piores em design, puzzle mais que combate.
            </p>
        </div>
    </article>
        <article class="card">
        <img src="../images/Gwyn.webp" alt="Gwyn, Lord of Cinder">

        <div class="card-conteudo">
            <h2>Gwyn, Lord of Cinder</h2>
            <p>
                Último chefe, simboliza o fim da era do fogo.
        </div>
    </article>

</section>

    <%- include('partials/footer.ejs') %>
</body>